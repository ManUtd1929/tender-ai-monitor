TELEGRAM_BOT_TOKEN=

# OpenAI (Responses API). Реальный ключ хранить только в .env (не в git).
# Legacy OPENAI_MODEL / OPENAI_TRIAGE_REASONING_EFFORT / DEEP_MODEL всё ещё читаются кодом как fallback,
# но production-конфиг задаётся переменными ниже.
OPENAI_API_KEY=

DATABASE_PATH=data/tenders.db

# --- AI budget / production models (src/ai/budget_settings.py) ---
# HARD-лимит месяца по локальному ledger (UTC). Не полагаться только на dashboard OpenAI.
MONTHLY_AI_BUDGET_USD=15
# Выше soft limit Deep откладывается (budget_deferred), дешёвый triage продолжается.
AI_SOFT_LIMIT_USD=12

# Приоритет: TRIAGE_MODEL > OPENAI_MODEL (legacy) > gpt-5.6-luna. CLI --model evaluator'ов выше всего.
TRIAGE_MODEL=gpt-5.6-luna
TRIAGE_REASONING_EFFORT=medium
# Deep primary: DEEP_PRIMARY_MODEL > DEEP_MODEL (legacy, только пока DEEP_PRIMARY_MODEL не задан) > OPENAI_MODEL > luna.
DEEP_PRIMARY_MODEL=gpt-5.6-luna
DEEP_PRIMARY_REASONING_EFFORT=high
# Fallback настроен, но автоматически НЕ вызывается (эскалации пока нет).
DEEP_FALLBACK_MODEL=gpt-5.6-terra
DEEP_FALLBACK_REASONING_EFFORT=high

# Оценка input выше лимита -> deferred_input_too_large (deep_input_limit_exceeded), модель не вызывается, контекст не режется.
MAX_DEEP_INPUT_TOKENS=140000
# Опциональный cap консервативной оценки одного Deep-вызова.
MAX_SINGLE_DEEP_ESTIMATED_COST_USD=0.75
# Порог value-gate в AMD. Значения по умолчанию НЕТ: пока не задан, value-based auto-skip выключен.
# MIN_DEEP_VALUE_AMD=

# AI-анализ в monitor (src/ai/analysis_pipeline.py). По умолчанию ВЫКЛЮЧЕН: без явного true monitor не создаёт analyzers и не вызывает OpenAI.
AI_ANALYSIS_ENABLED=false
# Максимум тендеров, выбранных AI за ОДИН запуск monitor (не дневной и не бизнес-лимит: остаток backlog идёт в следующий запуск).
# Обязателен при AI_ANALYSIS_ENABLED=true: целое > 0; пусто/0/отрицательное/нечисло -> AI не запускается (config_error), unlimited нет.
AI_ANALYSIS_BATCH_LIMIT=5
